[Unit]
# PATIO ist seit dem Umbau zum Firmenserver reine Web-API + WebUI:
# kein Telegram-Bot, keine LLM-Laufzeit. Die frueheren Abhaengigkeiten
# auf ollama.service sind entfallen — die Unit haette sonst auf einen
# Dienst gewartet, den es gar nicht mehr gibt.
Description=PATIO — Web-API und Weboberflaeche
Documentation=https://docs.patio.at
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=patio
WorkingDirectory=/opt/patio
EnvironmentFile=/opt/patio/.env
Environment=LANG=de_AT.UTF-8 LC_ALL=de_AT.UTF-8
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=patio

# Resource Limits
MemoryMax=512M
MemoryHigh=384M
CPUQuota=100%
TasksMax=64

# Sicherheit
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# /opt/patio/.chat_id ist raus — Telegram-Artefakt ohne Konsumenten.
ReadWritePaths=/opt/patio/logs /opt/patio-workspace /opt/patio/data /opt/patio/tools
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
