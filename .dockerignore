# Abhängigkeiten (werden im Container neu installiert)
node_modules/

# Build-Artefakte (werden im Container gebaut)
dist/

# Laufzeit-Daten (werden als Volumes gemountet)
.env
logs/
workspace/
data/
tools/
.chat_id

# Git
.git/
.gitignore

# Entwicklung
*.log
*.jsonl
.DS_Store
Thumbs.db

# Dokumentation — wird vom Dienst NICHT ausgeliefert (geprueft: kein
# serveStatic darauf in src/api/server.ts), gehoert also nicht ins Image.
# Die Doku-QUELLE wird im Image gebraucht (build:all baut sie nach dist/docs
# und der Server liefert sie unter /docs/ aus). Nur Cache und Altausgabe raus.
docs/.vitepress/cache/
docs/.vitepress/dist/

# Auslieferungspakete. OHNE diese Zeile schickt jeder `docker build` die
# gespeicherten Images als Bau-Kontext mit — gemessen 169 von 172 MB, und es
# waechst mit jedem Paket. Der Bau wird dadurch immer langsamer, ohne dass
# jemand den Grund sieht.
release/

# Archiv (abgeloeste Skripte und Ansichten) — nur Nachschlagewerk.
_archive/

# Betriebs-Vorlagen (systemd). Kommen ueber das Auslieferungspaket auf
# den Server, nicht ueber das Image.
deploy/

# Tests laufen auf dem Entwicklungsrechner, nicht im Image. tsconfig.json
# baut ohnehin nur src/**/*.
tests/
