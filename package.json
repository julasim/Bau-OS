{
  "name": "patio",
  "version": "1.0.0",
  "description": "PATIO — KI-Plattform fuer Architektur- und Planungsbueros (Planung, Projektsteuerung). Planungswerkzeug fuers Buero — nicht fuer die Baustelle.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const f=require('fs'); f.cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "build:all": "npm run build && vite build --config web/vite.config.ts && npm run docs:build",
    "typecheck:web": "vue-tsc --noEmit -p web/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "dev:web": "vite dev --config web/vite.config.ts",
    "start": "node dist/index.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "db:migrate": "tsx scripts/db-migrate.ts migrate",
    "db:status": "tsx scripts/db-migrate.ts status",
    "db:import": "tsx scripts/import-vault.ts",
    "db:reencrypt": "tsx scripts/reencrypt.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ scripts/ web/src electron/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-electron-assets.mjs",
    "electron:dev": "npm run build:electron && electron dist-electron/main.js",
    "dist": "npm run build:electron && electron-builder --config electron-builder.yml",
    "knip": "knip"
  },
  "author": "Julius Sima",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@types/node": "^25.5.2",
    "@types/node-cron": "^3.0.11",
    "angular-expressions": "^1.5.5",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "docxtemplater": "^3.68.6",
    "dompurify": "^3.3.3",
    "dotenv": "^17.4.0",
    "file-type": "^22.0.1",
    "hono": "^4.12.12",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "postgres": "^3.4.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^16.4.0",
    "marked": "^18.0.0",
    "prettier": "^3.8.2",
    "tailwindcss": "^4.2.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "esbuild": "0.27.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "tests/**/*.ts": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "web/src/**/*.{ts,vue}": [
      "prettier --write"
    ]
  }
}
