# PATIO Konfiguration
# Kopiere diese Datei nach .env und fülle die Werte aus:
#   cp .env.example .env
# Oder führe den interaktiven Installer aus:
#   npm run setup

# ── Pflichtfelder ─────────────────────────────────────────────────────────────
#
# Alle drei Werte in diesem Block MÜSSEN gesetzt sein. Fehlt einer davon,
# bricht der Boot mit einer Meldung und Exit-Code 1 ab (src/index.ts).
# Das ist Absicht: ein Dienst, der ohne seine Pflicht-Konfiguration startet,
# sieht für Docker/systemd gesund aus und ist trotzdem tot.

# Pfad zum Workspace (dort liegen die Dokumente als Dateien)
# Linux Beispiel:   /home/patio/workspace
# Windows Beispiel: C:\Users\Julius\Patio
WORKSPACE_PATH=

# Verbindung zur PostgreSQL-Datenbank.
# PATIO läuft AUSSCHLIESSLICH gegen Postgres — einen Filesystem-Modus gibt
# es seit dem Umbau zum Firmenserver nicht mehr. Alle Repos in src/data/
# sind Postgres-Repos; ohne DATABASE_URL wäre jeder Datenzugriff ein 500er.
#
# Beim Docker-Compose-Setup NICHT hier setzen: docker-compose.yml baut die
# DATABASE_URL automatisch aus POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# zusammen und zeigt auf den Container 'postgres' (siehe unten).
# Bare-Metal-Setup (ohne Docker): hier direkt den Connection-String setzen.
DATABASE_URL=postgres://patio:DEIN_PASSWORT@localhost:5432/patio

# JWT Secret für den Web-Login (generieren mit: openssl rand -base64 48).
# Die Web-API ist der einzige Dienst von PATIO — ohne Secret gäbe es keinen
# Login und damit keinen Dienst. Mindestens 32 Zeichen; in Production
# verweigert der Start bei kürzeren Secrets.
JWT_SECRET=

# ── Web-Oberfläche ────────────────────────────────────────────────────────────

# Port für die Web-Oberfläche (Standard: 3000)
API_PORT=3000

# Public-Base-URL für Links in Emails (Magic-Link, Password-Reset).
# Default leer → Backend nimmt Host aus dem Request-Header (Reverse-Proxy
# muss Host korrekt forwarden — Caddy/Nginx-Standard tut das). Setzen
# wenn die App hinter einem CDN sitzt oder die Public-URL anders ist.
# Beispiel: APP_URL=https://app.patio.at
APP_URL=

# ── SMTP / Email (Pflicht für 2FA-Login) ─────────────────────────────────────
#
# PATIO schickt 6-stellige Login-Codes per Email — jeder User muss eine
# Email-Adresse hinterlegen. Ohne SMTP_HOST landet der Code im Server-Log
# (Dev-Modus); in Production verweigert das Backend den Boot wenn User mit
# Email existieren aber SMTP fehlt.
#
# Beispiele:
#   Gmail (mit App-Password):
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USER=du@gmail.com
#     SMTP_PASS=<App-Password aus https://myaccount.google.com/apppasswords>
#     SMTP_FROM="PATIO <du@gmail.com>"
#
#   Office365 / Outlook:
#     SMTP_HOST=smtp.office365.com
#     SMTP_PORT=587
#     SMTP_USER=du@firma.at
#     SMTP_PASS=<App-Password>
#     SMTP_FROM="PATIO <du@firma.at>"
#
#   Mailgun:
#     SMTP_HOST=smtp.eu.mailgun.org   (oder smtp.mailgun.org)
#     SMTP_PORT=587
#     SMTP_USER=postmaster@mg.deinedomain.at
#     SMTP_PASS=<API-Key>
#     SMTP_FROM="PATIO <noreply@deinedomain.at>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PATIO <noreply@patio.local>
# auto = TLS bei 465, STARTTLS bei 587/25. true/false ueberschreibt.
SMTP_SECURE=auto

# ── Datenbank-Zugangsdaten (nur Docker-Compose) ───────────────────────────────
#
# Projekte, Notizen, Aufgaben, Termine, Team und Datei-Metadaten liegen
# vollständig in PostgreSQL — es gibt keinen JSON/Markdown-Modus mehr.
# (Auch die früher hier behaupteten "immer filesystem-basierten" Chat-Sessions
# und Agent-Logs sind mit der Bot-/Agenten-Laufzeit entfallen.)
#
# Diese drei Variablen richten den postgres-Container ein; docker-compose.yml
# baut daraus die DATABASE_URL für den app-Container zusammen. Beim
# Bare-Metal-Setup sind sie irrelevant — dort zählt nur DATABASE_URL oben.
POSTGRES_USER=patio
POSTGRES_PASSWORD=patio
POSTGRES_DB=patio

# ── Caddy Reverse-Proxy (nur fuer Standalone-Modus) ─────────────────────────
#
# PATIO nutzt standardmaessig einen ZENTRALEN Edge-Proxy (separates Repo
# /opt/proxy, julasim/Proxy auf GitHub) — der hat seine eigene Caddyfile,
# laeuft auf 80/443 und proxied via dem externen Docker-Netzwerk `proxy`
# zu allen Apps. PATIO haengt sich da rein (siehe docker-compose.yml).
#
# Diese Variablen sind nur relevant wenn du PATIO STANDALONE laufen
# laesst (ohne zentralen Edge-Proxy) — dafuer gibt es
# docker/docker-compose.standalone.yml mit eigenem caddy-Service:
#
# CADDY_DOMAIN=patio.meine-firma.at
# CADDY_EMAIL=admin@meine-firma.at
