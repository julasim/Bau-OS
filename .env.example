# PATIO Konfiguration
# Kopiere diese Datei nach .env und fülle die Werte aus:
#   cp .env.example .env
# Oder führe den interaktiven Installer aus:
#   npm run setup

# ── Pflichtfelder ─────────────────────────────────────────────────────────────

# Telegram Bot Token (von @BotFather → /newbot)
BOT_TOKEN=

# Pfad zum Workspace (wo Notizen, Aufgaben, Agenten gespeichert werden)
# Linux Beispiel:   /home/patio/workspace
# Windows Beispiel: C:\Users\Julius\Patio
WORKSPACE_PATH=

# ── LLM: Option A – OpenAI (empfohlen) ───────────────────────────────────────

# OpenAI API Key → automatisch gpt-4o-mini als Standard, gpt-4o für Vision
# Wenn gesetzt, wird Ollama ignoriert.
# OPENAI_API_KEY=sk-...

# Modell überschreiben (optional, Standard: gpt-4o-mini)
# OLLAMA_MODEL=gpt-4o-mini

# Vision-Modell für Fotos/Bilder (optional, Standard: gpt-4o)
# VISION_MODEL=gpt-4o

# ── LLM: Option B – Ollama lokal ─────────────────────────────────────────────

# Ollama API URL (Standard wenn Ollama lokal läuft)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Hauptmodell für den Agenten
# Lokal:  qwen2.5:7b       (braucht ~4.3 GB RAM, vorher: ollama pull qwen2.5:7b)
# Cloud:  kimi-k2.5:cloud  (kein lokaler RAM nötig, einmalig: ollama signin)
OLLAMA_MODEL=kimi-k2.5:cloud

# Modell für /fast Modus (optional, Standard = OLLAMA_MODEL)
# OLLAMA_FAST_MODEL=qwen2.5:7b

# Modell für Sub-Agenten (optional, Standard = OLLAMA_MODEL)
# OLLAMA_SUBAGENT_MODEL=qwen2.5:7b

# ── Web-Oberfläche (Vault-Editor) ─────────────────────────────────────────────

# JWT Secret für Web-Login (generiere mit: openssl rand -hex 32)
# Wenn gesetzt, wird die Web-Oberfläche auf API_PORT gestartet
JWT_SECRET=

# Port für die Web-Oberfläche (Standard: 3000)
API_PORT=3000

# Public-Base-URL für Links in Emails (Magic-Link, Password-Reset).
# Default leer → Backend nimmt Host aus dem Request-Header (Reverse-Proxy
# muss Host korrekt forwarden — Caddy/Nginx-Standard tut das). Setzen
# wenn die App hinter einem CDN sitzt oder die Public-URL anders ist.
# Beispiel: APP_URL=https://app.patio.at
APP_URL=

# ── Microsoft Graph (Outlook-Calendar-Sync) ─────────────────────────────────
#
# Optional. Wenn gesetzt, koennen User ihr Outlook-Konto in den PATIO-
# Settings verbinden — Termine syncen automatisch beidseitig.
#
# Setup-Schritte (einmalig fuer den Admin):
#   1. portal.azure.com → "App-Registrierungen" → "+ Neue Registrierung"
#      - Name: PATIO
#      - Konten in einem beliebigen Organisationsverzeichnis und persoenliche MS-Konten
#      - Umleitungs-URI: Web → <APP_URL>/api/auth/microsoft/callback
#        Beispiel: http://76.13.10.79:8080/api/auth/microsoft/callback
#   2. Auf der App-Uebersicht "Anwendungs-ID" und "Verzeichnis-ID" kopieren.
#   3. "Zertifikate & Geheimnisse" → "+ Neuer geheimer Clientschluessel"
#      → Wert SOFORT kopieren (wird nur einmal angezeigt).
#   4. "API-Berechtigungen" → "+ Berechtigung hinzufuegen" → Microsoft Graph
#      → Delegierte Berechtigungen: Calendars.ReadWrite, User.Read, offline_access
#      → "Administratorzustimmung erteilen".
#
# Tenant-ID: konkrete UUID fuer Single-Tenant. "common" fuer Multi-Tenant
# (jeder MS-User darf sich verbinden — bequem fuer Test, fuer Production
# einschraenken auf eigene Tenant-UUID).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# Optional: Redirect-URI explizit setzen. Default leer → Backend baut sie
# aus APP_URL + /api/auth/microsoft/callback. Muss EXAKT mit dem in Azure
# registrierten Wert uebereinstimmen.
MS_REDIRECT_URI=

# ── SMTP / Email (Pflicht für 2FA-Login) ─────────────────────────────────────
#
# PATIO schickt 6-stellige Login-Codes per Email — jeder User muss eine
# Email-Adresse hinterlegen. Ohne SMTP_HOST landet der Code im Server-Log
# (Dev-Modus); in Production verweigert das Backend den Boot wenn User mit
# Email existieren aber SMTP fehlt.
#
# Beispiele:
#   Gmail (mit App-Password):
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USER=du@gmail.com
#     SMTP_PASS=<App-Password aus https://myaccount.google.com/apppasswords>
#     SMTP_FROM="PATIO <du@gmail.com>"
#
#   Office365 / Outlook:
#     SMTP_HOST=smtp.office365.com
#     SMTP_PORT=587
#     SMTP_USER=du@firma.at
#     SMTP_PASS=<App-Password>
#     SMTP_FROM="PATIO <du@firma.at>"
#
#   Mailgun:
#     SMTP_HOST=smtp.eu.mailgun.org   (oder smtp.mailgun.org)
#     SMTP_PORT=587
#     SMTP_USER=postmaster@mg.deinedomain.at
#     SMTP_PASS=<API-Key>
#     SMTP_FROM="PATIO <noreply@deinedomain.at>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PATIO <noreply@patio.local>
# auto = TLS bei 465, STARTTLS bei 587/25. true/false ueberschreibt.
SMTP_SECURE=auto

# ── Datenbank (PostgreSQL + pgvector) ─────────────────────────────────────────
#
# Projekte, Notizen, Tasks, Termine, Team, Datei-Uploads und Embeddings
# landen in der Datenbank wenn DATABASE_URL gesetzt ist. Ohne DATABASE_URL
# laeuft alles als JSON/Markdown im Workspace-Verzeichnis — fuer lokalen
# Dev-Betrieb OK, aber auf dem VPS immer Postgres benutzen (pgvector noetig
# fuer semantische Suche + Embeddings).
#
# Chat-Sessions und Agent-Logs sind IMMER filesystem-basiert, unabhaengig
# von DATABASE_URL (data/chat/<agent>.jsonl, logs/agent-logs.jsonl).
#
# Docker-Compose-Setup: docker-compose.yml baut die DATABASE_URL automatisch
# aus POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB zusammen und zeigt auf den
# Container 'postgres'. Nur diese drei Variablen noetig:
POSTGRES_USER=patio
POSTGRES_PASSWORD=patio
POSTGRES_DB=patio

# Bare-Metal-Setup (ohne Docker): hier direkt den Connection-String setzen.
# DATABASE_URL=postgres://patio:DEIN_PASSWORT@localhost:5432/patio

# ── Caddy Reverse-Proxy (nur fuer Standalone-Modus) ─────────────────────────
#
# PATIO nutzt standardmaessig einen ZENTRALEN Edge-Proxy (separates Repo
# /opt/proxy, julasim/Proxy auf GitHub) — der hat seine eigene Caddyfile,
# laeuft auf 80/443 und proxied via dem externen Docker-Netzwerk `proxy`
# zu allen Apps. PATIO haengt sich da rein (siehe docker-compose.yml).
#
# Diese Variablen sind nur relevant wenn du PATIO STANDALONE laufen
# laesst (ohne zentralen Edge-Proxy). Dafuer in der docker-compose.yml
# den auskommentierten caddy-Service wieder aktivieren und das proxy-
# Netzwerk entfernen, dann hier eine Domain setzen:
#
# CADDY_DOMAIN=patio.meine-firma.at
# CADDY_EMAIL=admin@meine-firma.at
# HTTP_PORT=80
# HTTPS_PORT=443

# Supabase Client (fuer Realtime, Storage, Auth)
# Wird von setup-supabase.sh ausgegeben
# SUPABASE_URL=http://localhost:8000
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────

# Embedding-Modell (Standard: text-embedding-3-small bei OpenAI, nomic-embed-text bei Ollama)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ── Obsidian-Ordner ───────────────────────────────────────────────────────────

# Unterordner im Vault für Daily Notes (Standard: Daily)
# DAILY_NOTES_DIR=Daily

# Unterordner für Templates (Standard: Templates)
# TEMPLATES_DIR=Templates

# Unterordner für Anhänge/Uploads (Standard: Attachments)
# ATTACHMENTS_DIR=Attachments
